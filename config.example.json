{
  "primary_provider": "vertex_gemini",
  "fallback_provider": "azure_gpt5mini",
  "database": "data/rolelens.db",
  "profile_dir": "profile",
  "secrets_file": "secrets.env",
  "lock_file": "data/rolelens.lock",

  "use_jobstream": true,
  "jobstream_lookback_hours": 24,
  "jobstream_max_window_hours": 72,

  "search_terms": [
    "AI engineer",
    "product engineer",
    "solutions engineer",
    "systemutvecklare"
  ],
  "location_terms": [
    "Stockholm",
    "Göteborg",
    "Malmö"
  ],
  "include_unlocated_searches": true,
  "search_limit": 50,
  "query_delay_ms": 120,

  "career_sites": [
    {
      "platform": "teamtailor",
      "name": "omegapoint",
      "url": "https://omegapoint.teamtailor.com",
      "company": "Omegapoint"
    },
    {
      "platform": "greenhouse",
      "name": "mentimeter",
      "board": "mentimeter",
      "company": "Mentimeter"
    },
    {
      "platform": "varbi",
      "name": "uppsala-universitet",
      "url": "https://uu.varbi.com",
      "company": "Uppsala universitet",
      "city": "Uppsala",
      "region": "Uppsala län"
    },
    {
      "platform": "smartrecruiters",
      "name": "vattenfall",
      "board": "vattenfall",
      "company": "Vattenfall",
      "enabled": false
    }
  ],
  "career_site_max_details": 40,

  "evaluate_top_share": 0.15,
  "degraded_top_share": 0.30,
  "explore_share": 0.03,
  "use_enrichment": true,
  "exclude_student_roles": true,
  "ranking_reference_days": 3,
  "max_rank_per_run": 6000,
  "embedding_model": "gemini-embedding-001",
  "embedding_batch_size": 20,
  "embedding_timeout_seconds": 60,

  "triage_model": "gemini-2.5-flash-lite",
  "triage_thinking_budget": 1024,
  "triage_batch_size": 20,
  "monthly_budget_usd": 50,

  "max_candidates_per_run": 300,
  "max_jobs_per_batch": 10,
  "max_run_seconds": 3000,
  "max_prompt_chars": 180000,
  "max_job_description_chars": 9000,
  "max_notifications_per_run": 8,

  "jobstream_timeout_seconds": 90,
  "jobsearch_timeout_seconds": 30,
  "career_site_timeout_seconds": 45,
  "gateway_timeout_seconds": 150,
  "http_retries": 4,

  "preferred_locations": [
    "Stockholm",
    "Göteborg",
    "Malmö"
  ],
  "northern_exclusions": [
    "Kiruna",
    "Norrbottens län"
  ]
}
