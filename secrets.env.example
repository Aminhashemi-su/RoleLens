# Copy to your RoleLens home directory, add the provider credentials, then
# restrict the file:
#
#   cp secrets.env.example ~/.rolelens/secrets.env
#   chmod 600 ~/.rolelens/secrets.env
#
# RoleLens loads this file itself, because a script-only scheduled job does
# not inherit provider credentials from the scheduler process.
#
# Values are never committed. Names only below.

# Primary evaluator — Vertex AI Gemini
VERTEX_GEMINI_API_KEY=
VERTEX_GEMINI_MODEL=gemini-3.7-flash

# Transport-only fallback — Azure OpenAI
# BASE_URL is the deployment endpoint; "/chat/completions" is appended if absent.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_DEPLOYMENT=

# Optional, benchmark tooling only. Never used by automatic production routing.
AI_GATEWAY_API_KEY=
